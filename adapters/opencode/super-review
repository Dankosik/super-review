#!/bin/sh
set -eu

review_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
worker_file=${XDG_CONFIG_HOME:-"$HOME/.config"}/super-review/opencode-specialist-model
worker_model=${SUPER_REVIEW_SPECIALIST_MODEL:-}
if [ -z "$worker_model" ] && [ -f "$worker_file" ]; then
  worker_model=$(cat "$worker_file")
fi
case "$worker_model" in
  ''|*[!A-Za-z0-9._:/-]*)
    printf '%s\n' 'Choose a specialist model from your configured provider first.' \
      'Set SUPER_REVIEW_SPECIALIST_MODEL=provider/model-id, or save that ID in:' \
      "$worker_file" >&2
    exit 64
    ;;
esac
case "$worker_model" in
  */*) ;;
  *) printf '%s\n' 'The specialist model must use provider/model-id format.' >&2; exit 64 ;;
esac
export SUPER_REVIEW_SPECIALIST_MODEL="$worker_model"
opencode_bin=${OPENCODE_BIN:-opencode}
if ! command -v "$opencode_bin" >/dev/null 2>&1; then
  printf '%s\n' 'OpenCode is not available. Install OpenCode or set OPENCODE_BIN to its executable.' >&2
  exit 127
fi
export OPENCODE_CONFIG_DIR="$review_root"
# Agents and permissions in the reviewed repository's .opencode must not
# replace or widen the review roles.
export OPENCODE_DISABLE_PROJECT_CONFIG=1

if "$opencode_bin" --help 2>&1 | grep -q -- '--standalone'; then
  # OpenCode 2 attaches to a shared background service that ignores this
  # environment, so run a private server. OPENCODE_CONFIG_DIR replaces the
  # global directory there: keep the user's global config file for models and
  # providers, and select the review agent and specialist model last.
  if [ -z "${OPENCODE_CONFIG:-}" ]; then
    global_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/opencode
    for name in opencode.jsonc opencode.json config.json; do
      if [ -f "$global_dir/$name" ]; then
        export OPENCODE_CONFIG="$global_dir/$name"
        break
      fi
    done
  fi
  export OPENCODE_CONFIG_CONTENT="{\"default_agent\":\"super-review\",\"agent\":{\"super-review-specialist\":{\"model\":\"$worker_model\"}}}"
  if [ "$#" -eq 0 ]; then
    exec "$opencode_bin" --standalone
  fi
  exec "$opencode_bin" --standalone --prompt "Use Super Review for this request: $*"
fi

if [ "$#" -eq 0 ]; then
  exec "$opencode_bin" --pure --agent super-review
fi
exec "$opencode_bin" --pure --agent super-review --prompt "Use Super Review for this request: $*"
