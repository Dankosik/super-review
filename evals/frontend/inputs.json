        "path": "ExportButton.tsx",
        "content": "import { useState } from \"react\";\ntype Row = { name: string; enabled: boolean; quantity: number };\ntype Props = { rows: Row[]; save: (body: string) => Promise<void> };\nexport function ExportButton({ rows, save }: Props) {\n  const [pending, setPending] = useState(false);\n  async function exportRows() {\n    setPending(true);\n    try {\n      const selected = rows.filter(row => row.enabled);\n      const groups = new Map<string, number>();\n      for (const row of selected) groups.set(row.name, (groups.get(row.name) ?? 0) + row.quantity);\n      const lines = [...groups].sort(([a], [b]) => a.localeCompare(b)).map(([name, quantity]) => `${JSON.stringify(name)}:${quantity}`);\n      await save(lines.join(\"\\n\"));\n    } finally { setPending(false); }\n  }\n  return <button disabled={pending} onClick={exportRows}>Export</button>;\n}\n",
        "sha256": "ec646b016629c6be6b02c034ab006b608afe45ca5f07439f8f4dd6861c87d0ce"
