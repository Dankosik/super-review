+// docs/guides/cache.md, "Wire feature-owned behavior": "`namespace` panics
+// unless the name matches `^[a-z][a-z0-9_]{0,63}$`."
+#[test]
+#[should_panic(expected = "cache namespace")]
+fn witness_a_namespace_name_one_past_the_length_bound_panics() {
+    let cache = admitted("redis://127.0.0.1:6379", true, true);
+    let name = Box::leak("a".repeat(65).into_boxed_str());
+    let _ = cache.namespace(name);
+}
