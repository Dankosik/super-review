+// docs/guides/cache.md, "Observability": "... or a password file that cannot
+// be read when a connection opens, as `auth`."
+#[tokio::test]
+#[expect(
+    clippy::disallowed_methods,
+    reason = "test-owned temporary file setup or rotation completes before the corresponding fixture assertion"
+)]
+async fn witness_a_password_file_unreadable_when_a_connection_opens_is_auth() {
+    use health::Probe;
+
+    let server = FakeServer::start().await;
+    let file = tempfile::NamedTempFile::new().expect("password file");
+    std::fs::write(file.path(), "secret\n").expect("initial password");
+    let cache = Cache::start(with_password_file(
+        &format!("redis://{}", server.address),
+        file.path().to_path_buf(),
+    ))
+    .expect("start cache");
+    // Current-thread runtime: the supervisor has not run its first setup yet.
+    std::fs::remove_file(file.path()).expect("password file removed after admission");
+    let refused = tokio::time::timeout(Duration::from_secs(5), cache.probe().check())
+        .await
+        .expect("the first setup attempt ends")
+        .expect_err("the file cannot be read");
+    assert_eq!(refused.to_string(), "cache ping failed: auth");
+}
