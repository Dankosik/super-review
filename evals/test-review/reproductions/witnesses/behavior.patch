+// docs/guides/cache.md, "Observability": "The client span is `cache`,
+// exported under the name `GET`, `SET`, or `DEL` (`otel.name`)".
+#[test]
+fn witness_the_client_span_is_exported_under_the_command_name() {
+    use crate::observe::{ErrorType, NamespaceHistograms, Operation, OperationGuard};
+
+    let captured = CapturedLogs::default();
+    let writer = captured.clone();
+    let subscriber = tracing_subscriber::fmt()
+        .without_time()
+        .with_ansi(false)
+        .with_max_level(tracing::Level::DEBUG)
+        .with_writer(move || writer.clone())
+        .finish();
+    let server = crate::ServerEndpoint {
+        host: "cache.example".to_owned(),
+        port: 6379,
+        tls: true,
+    };
+    tracing::subscriber::with_default(subscriber, || {
+        let histograms = NamespaceHistograms::default();
+        for operation in [Operation::Get, Operation::Set, Operation::Delete] {
+            let _ = OperationGuard::start("spans", &histograms, operation, &server)
+                .fail(ErrorType::Io);
+        }
+    });
+    let logs = captured.rendered();
+    for command in ["GET", "SET", "DEL"] {
+        assert!(logs.contains(&format!("otel.name=\"{command}\"")), "{logs}");
+    }
+}
