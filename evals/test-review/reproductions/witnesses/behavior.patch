+// docs/guides/cache.md, "Observability": "`outcome` (`hit`, `miss`, `ok`,
+// `error`, `timeout`, or `cancelled`) ... Hit, miss, and error counts are the
+// `_count` series."; src/lib.rs: "a hit returns the bytes".
+#[test]
+fn witness_a_stored_value_is_returned_and_recorded_as_a_hit() {
+    let recorder = observation_recorder();
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("test runtime");
+    metrics::with_local_recorder(&recorder, || {
+        runtime.block_on(async {
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+                .await
+                .expect("hit listener");
+            let address = listener.local_addr().expect("listener address");
+            tokio::spawn(async move {
+                use tokio::io::AsyncWriteExt;
+                while let Ok((stream, _)) = listener.accept().await {
+                    tokio::spawn(async move {
+                        let (read, mut write) = stream.into_split();
+                        let mut read = tokio::io::BufReader::new(read);
+                        let mut line = String::new();
+                        while let Some(arguments) = read_resp_arguments(&mut read, &mut line).await
+                        {
+                            let reply: &[u8] = match arguments.first().map(String::as_str) {
+                                Some("GET") => b"$5\r\nvalue\r\n",
+                                Some("PING") => b"+PONG\r\n",
+                                _ => b"+OK\r\n",
+                            };
+                            if write.write_all(reply).await.is_err() {
+                                return;
+                            }
+                        }
+                    });
+                }
+            });
+            let cache = admitted(&format!("redis://{address}"), true, true);
+            let namespace = cache.namespace("hits");
+            assert_eq!(namespace.get("key").await, Ok(Some(b"value".to_vec())));
+        });
+    });
+    let scrape = recorder.handle().render();
+    assert!(
+        scrape.contains(
+            "cache_operation_duration_seconds_count{cache=\"hits\",operation=\"get\",outcome=\"hit\"} 1"
+        ),
+        "{scrape}"
+    );
+}
