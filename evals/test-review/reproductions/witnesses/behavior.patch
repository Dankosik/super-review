+// docs/guides/cache.md, "Select and configure": "`cache.password_file` names a
+// file that holds the password alone (one trailing line break is ignored)".
+#[tokio::test]
+#[expect(
+    clippy::disallowed_methods,
+    reason = "test-owned temporary file setup or rotation completes before the corresponding fixture assertion"
+)]
+async fn witness_a_password_file_drops_only_one_trailing_line_break() {
+    let server = FakeServer::start().await;
+    server.require_password("secret\n");
+    let file = tempfile::NamedTempFile::new().expect("password file");
+    std::fs::write(file.path(), "secret\n\n").expect("password with two line breaks");
+    let cache = Cache::start(with_password_file(
+        &format!("redis://{}", server.address),
+        file.path().to_path_buf(),
+    ))
+    .expect("start cache");
+    assert_eq!(cache.namespace("one_break").get("ready").await, Ok(None));
+}
