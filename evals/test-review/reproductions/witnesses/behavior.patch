+// docs/guides/cache.md, "Observability": "a `HELLO` refused with `WRONGPASS`
+// or `NOAUTH`, or a password file that cannot be read when a connection
+// opens, as `auth`."
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn witness_a_hello_refused_with_noauth_is_reported_as_auth() {
+    use health::Probe;
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("noauth listener");
+    let address = listener.local_addr().expect("listener address");
+    tokio::spawn(async move {
+        use tokio::io::AsyncWriteExt;
+        while let Ok((stream, _)) = listener.accept().await {
+            tokio::spawn(async move {
+                let (read, mut write) = stream.into_split();
+                let mut read = tokio::io::BufReader::new(read);
+                let mut line = String::new();
+                while let Some(arguments) = read_resp_arguments(&mut read, &mut line).await {
+                    let reply: &[u8] = match arguments.first().map(String::as_str) {
+                        Some("HELLO") => b"-NOAUTH Authentication required.\r\n",
+                        _ => b"+OK\r\n",
+                    };
+                    if write.write_all(reply).await.is_err() {
+                        return;
+                    }
+                }
+            });
+        }
+    });
+    let cache = admitted(&format!("redis://:secret@{address}"), true, false);
+    let refused = tokio::time::timeout(Duration::from_secs(5), cache.probe().check())
+        .await
+        .expect("the first setup attempt ends")
+        .expect_err("the server refuses HELLO");
+    assert_eq!(refused.to_string(), "cache ping failed: auth");
+}
