+// Guide, "Observability": `error.type` reports "a password file that cannot be
+// read when a connection opens, as `auth`".
+#[tokio::test]
+#[expect(
+    clippy::disallowed_methods,
+    reason = "test-owned temporary file setup or rotation completes before the corresponding fixture assertion"
+)]
+async fn witness_an_unreadable_password_file_at_connection_setup_is_reported_as_auth() {
+    use health::Probe;
+
+    let server = FakeServer::start().await;
+    let file = tempfile::NamedTempFile::new().expect("password file");
+    std::fs::write(file.path(), "hunter2\n").expect("write password");
+    let cache = Cache::start(with_password_file(
+        &format!("redis://{}", server.address),
+        file.path().to_path_buf(),
+    ))
+    .expect("admission reads the file");
+    // No await since start: on this current-thread runtime the supervisor has
+    // not begun its first setup, which must read the file again.
+    file.close().expect("remove password file");
+    let refused = tokio::time::timeout(Duration::from_secs(5), cache.probe().check())
+        .await
+        .expect("the setup attempt ends")
+        .expect_err("the password file is gone");
+    assert_eq!(refused.to_string(), "cache ping failed: auth");
+}
