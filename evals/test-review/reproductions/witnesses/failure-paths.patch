+// Guide, "Failure and budgets": "A PING failure retires the generation even
+// with no traffic, so unanswered slots from cancelled callers cannot remain
+// forever." The PING budget is `min(command_timeout, 5 s)`.
+#[tokio::test]
+async fn witness_a_failed_maintenance_ping_replaces_a_silent_connection_without_traffic() {
+    let server = FakeServer::start().await;
+    let cache = admitted(&format!("redis://{}", server.address), true, true);
+    let namespace = cache.namespace("silent_peer");
+    assert_eq!(namespace.get("ready").await, Ok(None));
+    let old = server.stall_existing();
+    // No cache call from here on: only maintenance can notice the silent peer.
+    server
+        .wait_for(
+            Duration::from_secs(5),
+            "a silent connection was kept after its maintenance PING failed",
+            || server.connections() > old && server.closed_through(old),
+        )
+        .await;
+}
+
+// `ErrorType::Timeout`: "The operation context stopped (its deadline,
+// including `command_timeout`, or caller cancellation)". Outcome label: "A
+// timeout keeps its own value". Guide: a failed series carries `error_type`.
+#[tokio::test]
+async fn witness_a_dispatched_command_that_outlives_its_context_records_timeout() {
+    use operation_context::OperationContext;
+
+    let recorder = observation_recorder();
+    let _recorder = metrics::set_default_local_recorder(&recorder);
+    let server = FakeServer::start().await;
+    let cache = Cache::start(CacheOptions {
+        command_timeout: Duration::from_secs(30),
+        ..options(&format!("redis://{}", server.address), true, true, None)
+    })
+    .expect("start cache");
+    let namespace = cache.namespace("late_reply");
+    assert_eq!(namespace.get("ready").await, Ok(None));
+    server.stall_existing();
+    let context = OperationContext::with_timeout(Duration::from_millis(100));
+    assert_eq!(
+        namespace.get_with_context("late", &context).await,
+        Err(crate::Unavailable)
+    );
+    assert_eq!(server.command_count("GET", Some("late_reply:late")), 1);
+    let scrape = recorder.handle().render();
+    let series = "cache_operation_duration_seconds_count{cache=\"late_reply\",operation=\"get\",outcome=\"timeout\",error_type=\"timeout\"} 1";
+    assert!(scrape.contains(series), "{series} missing from {scrape}");
+}
+
+// `ErrorType::Timeout`: "... a setup or probe bound elapsed ...". `CacheProbe`:
+// "Failure text is `cache ping failed: <error.type>` only."
+#[tokio::test]
+async fn witness_a_setup_that_outlives_its_bound_is_reported_as_timeout() {
+    use health::Probe;
+
+    let server = FakeServer::start().await;
+    server
+        .observed
+        .silence_all
+        .store(true, std::sync::atomic::Ordering::SeqCst);
+    let cache = admitted(&format!("redis://{}", server.address), true, true);
+    let refused = tokio::time::timeout(Duration::from_secs(10), cache.probe().check())
+        .await
+        .expect("the setup bound ends the attempt")
+        .expect_err("a silent server never completes setup");
+    assert_eq!(refused.to_string(), "cache ping failed: timeout");
+}
