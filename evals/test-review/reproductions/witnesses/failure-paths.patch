+// Guide: "A later unreadable or empty file logs `cache_password_file_unreadable`
+// once per outage and preserves a usable connection and its accepted password."
+#[tokio::test]
+#[expect(
+    clippy::disallowed_methods,
+    reason = "test-owned temporary file setup or rotation completes before the corresponding fixture assertion"
+)]
+async fn witness_each_password_file_outage_logs_its_own_warning() {
+    let recorder = observation_recorder();
+    let _recorder = metrics::set_default_local_recorder(&recorder);
+    let captured = CapturedLogs::default();
+    let writer = captured.clone();
+    let subscriber = tracing_subscriber::fmt()
+        .without_time()
+        .with_ansi(false)
+        .with_writer(move || writer.clone())
+        .finish();
+    let _subscriber = tracing::subscriber::set_default(subscriber);
+    let server = FakeServer::start().await;
+    let password = ephemeral_password();
+    server.require_password(&password);
+    let file = tempfile::NamedTempFile::new().expect("password file");
+    std::fs::write(file.path(), format!("{password}\n")).expect("password");
+    let cache = Cache::start(with_password_file(
+        &format!("redis://{}", server.address),
+        file.path().to_path_buf(),
+    ))
+    .expect("start cache");
+    assert_eq!(cache.namespace("outages").get("ready").await, Ok(None));
+    let sampled = |outcome: &str, count: usize| {
+        password_refresh_samples(&recorder).contains(&format!(
+            "cache_password_file_refreshes_total{{outcome=\"{outcome}\",reason=\"none\"}} {count}"
+        ))
+    };
+
+    std::fs::remove_file(file.path()).expect("first outage");
+    server
+        .wait_for(Duration::from_secs(8), "first outage was not read", || {
+            sampled("read_failed", 1)
+        })
+        .await;
+    std::fs::write(file.path(), format!("{password}\n")).expect("file restored");
+    server
+        .wait_for(Duration::from_secs(8), "restored file was not read", || {
+            sampled("unchanged", 1)
+        })
+        .await;
+    std::fs::remove_file(file.path()).expect("second outage");
+    server
+        .wait_for(Duration::from_secs(8), "second outage was not read", || {
+            sampled("read_failed", 2)
+        })
+        .await;
+    assert_eq!(
+        captured
+            .rendered()
+            .matches("cache_password_file_unreadable")
+            .count(),
+        2,
+        "each outage logs once"
+    );
+}
