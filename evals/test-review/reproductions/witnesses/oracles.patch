+// Witness (oracles): docs/decisions/cache-decisions.md, "Histogram only":
+// "Hit, miss, and error counts are the `_count` series of
+// `cache_operation_duration_seconds`. Labels are ... `outcome` (`hit`, `miss`, ...)".
+#[test]
+fn witness_a_hit_records_into_the_hit_series() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let recorder = observation_recorder();
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("test runtime");
+    metrics::with_local_recorder(&recorder, || {
+        runtime.block_on(async {
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+                .await
+                .expect("hit listener");
+            let address = listener.local_addr().expect("listener address");
+            tokio::spawn(async move {
+                let Ok((mut stream, _)) = listener.accept().await else {
+                    return;
+                };
+                // Every command is answered in order; `GET` returns a value.
+                let mut request = [0; 512];
+                loop {
+                    let read = stream.read(&mut request).await.unwrap_or(0);
+                    if read == 0 {
+                        return;
+                    }
+                    let mut reply = Vec::new();
+                    let mut lines = request[..read].split(|&b| b == b'\n');
+                    while let Some(line) = lines.next() {
+                        if line.first() != Some(&b'*') {
+                            continue;
+                        }
+                        let _length = lines.next();
+                        if lines.next().is_some_and(|name| name.starts_with(b"GET")) {
+                            reply.extend_from_slice(b"$5\r\nvalue\r\n");
+                        } else {
+                            reply.extend_from_slice(b"+OK\r\n");
+                        }
+                    }
+                    if stream.write_all(&reply).await.is_err() {
+                        return;
+                    }
+                }
+            });
+            let cache = admitted(&format!("redis://{address}"), true, true);
+            let namespace = cache.namespace("hits");
+            assert_eq!(namespace.get("key").await, Ok(Some(b"value".to_vec())));
+        });
+    });
+    let scrape = recorder.handle().render();
+    let series = "cache_operation_duration_seconds_count{cache=\"hits\",operation=\"get\",outcome=\"hit\"} 1";
+    assert!(
+        scrape.lines().any(|line| line == series),
+        "{series} missing from {scrape}"
+    );
+}
