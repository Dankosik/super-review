+#[test]
+#[should_panic(expected = "cache namespace")]
+fn witness_a_namespace_name_with_an_uppercase_later_byte_panics() {
+    let cache = admitted("redis://127.0.0.1:6379", true, true);
+    let _ = cache.namespace("aB");
+}
